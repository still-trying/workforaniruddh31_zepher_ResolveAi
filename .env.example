[TEMPLATE]
# ResolveAI environment variables — names must match ARCHITECTURE.md Section 6.
# Copy to .env.local and fill in. .env.local is gitignored; this template is committed.
#
# Server-side only. NEVER add a NEXT_PUBLIC_ prefix to these:
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE=

# Supabase project URL. Consumed server-side (Edge Function, route handler, server components).
SUPABASE_URL=

# Optional. Not used by the browser: the execution and resolution pages read their data through
# server components (ARCHITECTURE.md Section 2), so no NEXT_PUBLIC_ Supabase variable is needed.
SUPABASE_ANON_KEY=
